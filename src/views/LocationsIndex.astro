---
import { getCollection } from 'astro:content';
import { siteConfig } from '@config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import LocationGrid from '@/components/sections/LocationGrid.astro';
import Trustindex from '@/components/Trustindex.astro';
import Cta from '@/components/sections/Cta.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { buildTitle, buildDescription } from '@/lib/seo';
import { getBusinessType } from '@/lib/business-types';
import * as S from '@/lib/schema';

const { business } = siteConfig;
const bt = getBusinessType(siteConfig.businessType);
const locations = await getCollection('locations');
const names = locations.map((l) => l.data.city);
const meta = {
  title: buildTitle(`${bt.label} Service Areas | ${business.address.city} & Surrounding Cities`),
  description: buildDescription(`${business.name} provides ${bt.label.toLowerCase()} in ${names.slice(0, 5).join(', ')}${names.length > 5 ? ' and more' : ''}. See if we serve your neighborhood and request a free quote.`),
  canonical: '/service-areas/',
};
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Service Areas', path: '/service-areas/' }];
const schema = S.graph(
  S.localBusiness({ full: true, areas: locations.map((l) => ({ city: l.data.city, state: l.data.state, cityUrl: l.data.cityUrl })) }),
  S.webSite(),
  S.webPage({ path: '/service-areas/', title: meta.title, description: meta.description, type: 'CollectionPage' }),
  S.breadcrumbList('/service-areas/', crumbs),
);
---
<BaseLayout meta={meta} schema={schema}>
  <Hero compact title="Areas We Serve" subtitle={`Proudly serving ${business.address.city} and communities within ${business.serviceRadiusMiles ?? 25} miles. Don’t see your city? Call us, we may still be able to help.`} />
  <div class="container-x pt-6"><Breadcrumbs crumbs={crumbs} /></div>
  <LocationGrid title="Cities and towns we serve" />
  <Trustindex placement="compact" title="What customers say" />
  <Cta />
</BaseLayout>
