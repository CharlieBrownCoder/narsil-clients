---
import { getCollection } from 'astro:content';
import { siteConfig } from '@config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import EmergencyCta from '@/components/sections/EmergencyCta.astro';
import ServiceGrid from '@/components/sections/ServiceGrid.astro';
import TrustBar from '@/components/sections/TrustBar.astro';
import Cta from '@/components/sections/Cta.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { buildTitle, buildDescription } from '@/lib/seo';
import { getBusinessType } from '@/lib/business-types';
import * as S from '@/lib/schema';

const { business } = siteConfig;
const bt = getBusinessType(siteConfig.businessType);
const emergencyServices = (await getCollection('services')).filter((s) => s.data.emergency);
const e = business.emergency;
const meta = { title: buildTitle(`24/7 Emergency ${bt.label} in ${business.address.city}, ${business.address.state}`), description: buildDescription(`Emergency ${bt.label.toLowerCase()} in ${business.address.city}, day or night. Call ${e?.phone ?? business.phone} and a real person answers. ${e?.text ?? ''}`), canonical: '/emergency/' };
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Emergency Service', path: '/emergency/' }];
const schema = S.graph(S.localBusiness({ full: true }), S.webSite(), S.webPage({ path: '/emergency/', title: meta.title, description: meta.description }), S.breadcrumbList('/emergency/', crumbs));
---
<BaseLayout meta={meta} schema={schema}>
  <Hero compact eyebrow="24/7" title={`Emergency ${bt.label.toLowerCase()} in ${business.address.city}`} subtitle={e?.text ?? 'Call now and a real person answers.'} />
  <EmergencyCta />
  <TrustBar />
  <div class="container-x pt-6"><Breadcrumbs crumbs={crumbs} /></div>
  {emergencyServices.length > 0 ? <ServiceGrid title="Available around the clock" only={emergencyServices.map((s) => s.id)} /> : <section class="section"><div class="container-x"><p class="text-slate-600">Mark services with <code>emergency: true</code> to list them here.</p></div></section>}
  <Cta title="Don't wait. Call now." />
</BaseLayout>
