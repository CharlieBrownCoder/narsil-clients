---
import { siteConfig } from '@config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import * as S from '@/lib/schema';
const { business } = siteConfig;
const meta = { title: `Privacy Policy | ${business.name}`, description: `How ${business.name} collects and uses information submitted through this website.`, canonical: '/privacy-policy/', noindex: true };
---
<BaseLayout meta={meta} schema={S.graph(S.localBusiness(), S.webSite())}>
  <article class="container-x max-w-3xl py-16 prose prose-site">
    <h1>Privacy Policy</h1>
    <p>Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</p>
    <h2>Information we collect</h2>
    <p>When you request a quote or contact us, we collect the details you provide, such as your name, phone number, email address, and job details. We also use standard analytics tools that collect anonymous usage data.</p>
    <h2>How we use it</h2>
    <p>We use your information to respond to your request, provide quotes, schedule and perform services, and improve this website. We do not sell your personal information.</p>
    <h2>Third parties</h2>
    <p>We may share information with service providers who help us operate the website and our business, such as form processing, analytics, and call tracking vendors.</p>
    <h2>Contact</h2>
    <p>Questions? Email <a href={`mailto:${business.email}`}>{business.email}</a> or call {business.phone}.</p>
    <p><em>This is a starter policy. Have it reviewed for your state’s requirements before launch.</em></p>
  </article>
</BaseLayout>
