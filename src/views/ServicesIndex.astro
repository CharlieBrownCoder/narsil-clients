---
import { getCollection } from 'astro:content';
import { siteConfig } from '@config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import ServiceGrid from '@/components/sections/ServiceGrid.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Cta from '@/components/sections/Cta.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { buildTitle, buildDescription } from '@/lib/seo';
import { getBusinessType } from '@/lib/business-types';
import { abs } from '@/lib/utils';
import * as S from '@/lib/schema';

const { business } = siteConfig;
const bt = getBusinessType(siteConfig.businessType);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const meta = {
  title: buildTitle(`${bt.label} Services in ${business.address.city}, ${business.address.state}`),
  description: buildDescription(`Explore every ${bt.label.toLowerCase()} service ${business.name} offers in ${business.address.city} and nearby: ${services.map((s) => s.data.shortTitle ?? s.data.title).join(', ')}. Free quotes.`),
  canonical: '/services/',
};
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }];
const schema = S.graph(
  S.localBusiness(),
  S.webSite(),
  S.webPage({ path: '/services/', title: meta.title, description: meta.description, type: 'CollectionPage' }),
  S.breadcrumbList('/services/', crumbs),
  { '@type': 'ItemList', '@id': abs('/services/#list'), itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.data.title, url: abs(`/services/${s.id}/`) })) },
);
---
<BaseLayout meta={meta} schema={schema}>
  <Hero compact title={`${bt.label} Services`} subtitle={`Everything we do in ${business.address.city} and the surrounding area, backed by ${siteConfig.trust.guarantees[0]?.toLowerCase() ?? 'our guarantee'}.`} />
  <div class="container-x pt-6"><Breadcrumbs crumbs={crumbs} /></div>
  <ServiceGrid title="All services" />
  <Testimonials />
  <Cta />
</BaseLayout>
