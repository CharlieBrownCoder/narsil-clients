---
import { siteConfig } from '@config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Trustindex from '@/components/Trustindex.astro';
import Cta from '@/components/sections/Cta.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { buildTitle, buildDescription } from '@/lib/seo';
import * as S from '@/lib/schema';

const { business, trust, reviews } = siteConfig;
const meta = { title: buildTitle(`${business.name} Reviews`), description: buildDescription(`Read verified customer reviews for ${business.name} in ${business.address.city}, ${business.address.state}.${trust.rating ? ` Rated ${trust.rating.value}/5 from ${trust.rating.count} ${trust.rating.source} reviews.` : ''}`), canonical: '/reviews/' };
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews/' }];
const schema = S.graph(S.localBusiness({ full: true }), S.webSite(), S.webPage({ path: '/reviews/', title: meta.title, description: meta.description, type: 'CollectionPage' }), S.breadcrumbList('/reviews/', crumbs));
---
<BaseLayout meta={meta} schema={schema}>
  <Hero compact eyebrow="Customer reviews" title={`What ${business.address.city} says about us`} subtitle={trust.rating ? `${trust.rating.value} out of 5 stars across ${trust.rating.count} ${trust.rating.source} reviews.` : 'Real reviews from real customers.'} />
  <div class="container-x pt-6"><Breadcrumbs crumbs={crumbs} /></div>
  {reviews.trustindex.page ? (
    <Trustindex placement="page" />
  ) : (
    <section class="section"><div class="container-x max-w-2xl text-center">
      <p class="text-slate-600">Reviews widget not configured. Set <code>reviews.trustindex.page</code> in <code>site.config.ts</code>.</p>
      {business.googleReviewUrl && <a href={business.googleReviewUrl} target="_blank" rel="noopener" class="btn-primary mt-6">Read our Google reviews</a>}
    </div></section>
  )}
  <Cta />
</BaseLayout>
