---
import { getCollection } from 'astro:content';
import { siteConfig } from '@config';
import Stars from '@/components/Stars.astro';
import Icon from '@/components/Icon.astro';
interface Props { limit?: number; service?: string; title?: string }
const { limit = 3, service, title = 'What our customers say' } = Astro.props;
let items = (await getCollection('testimonials')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
if (service) {
  const matched = items.filter((t) => t.data.service === service);
  if (matched.length >= 2) items = matched;
}
items = [...items.filter((t) => t.data.featured), ...items.filter((t) => !t.data.featured)].slice(0, limit);
const { trust, pages, business } = siteConfig;
---
{items.length > 0 && (
  <section class="section bg-secondary text-white">
    <div class="container-x">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <p class="eyebrow !text-accent">Reviews</p>
          <h2 class="mt-2 !text-white">{title}</h2>
        </div>
        {trust.rating && <p class="flex items-center gap-3 text-slate-300"><Stars rating={trust.rating.value} /> <span><strong class="text-white">{trust.rating.value}</strong> · {trust.rating.count} {trust.rating.source} reviews</span></p>}
      </div>
      <div class="mt-10 grid md:grid-cols-3 gap-6">
        {items.map((t) => (
          <blockquote class="bg-white/5 border border-white/10 rounded-[var(--radius-brand)] p-6 flex flex-col">
            <Icon name="quote" class="w-8 h-8 text-accent" />
            <p class="mt-3 text-slate-200 flex-1">“{t.data.text}”</p>
            <footer class="mt-5">
              <Stars rating={t.data.rating} class="w-4 h-4" />
              <p class="mt-2 font-semibold text-white">{t.data.name}</p>
              <p class="text-sm text-slate-400">{[t.data.location, t.data.source].filter(Boolean).join(' · ')}</p>
            </footer>
          </blockquote>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        {pages.reviews && <a href="/reviews/" class="btn-ghost">Read all reviews</a>}
        {business.googleReviewUrl && <a href={business.googleReviewUrl} target="_blank" rel="noopener" class="btn-accent">Leave a review</a>}
      </div>
    </div>
  </section>
)}
