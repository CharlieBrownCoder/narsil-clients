---
/** Coupon-style cards from config.offers. Hidden when empty. */
import { getCollection } from 'astro:content';
import { siteConfig } from '@config';
import Icon from '@/components/Icon.astro';
const { offers, pages } = siteConfig;
const services = await getCollection('services');
interface Props { title?: string }
const { title = 'Current specials' } = Astro.props;
---
{offers.length > 0 && (
  <section class="section bg-neutral">
    <div class="container-x">
      <p class="eyebrow">Save</p>
      <h2 class="mt-2">{title}</h2>
      <ul class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {offers.map((o) => { const svc = o.service ? services.find((s) => s.id === o.service) : undefined; return (
          <li class="relative bg-white border-2 border-dashed border-accent rounded-[var(--radius-brand)] p-6 flex flex-col">
            <p class="font-heading text-2xl font-extrabold text-secondary">{o.title}</p>
            <p class="mt-2 text-slate-600 flex-1">{o.detail}</p>
            <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
              {o.code && <span class="font-mono font-bold tracking-wider bg-accent/15 text-secondary px-2 py-1 rounded">{o.code}</span>}
              {o.expires && <span class="text-slate-500">{o.expires}</span>}
            </div>
            <div class="mt-5 flex flex-wrap gap-3">
              {pages.contact && <a href="/contact/" data-cta="offer-quote" class="btn-primary !py-2">Claim this offer</a>}
              {svc && <a href={`/services/${svc.id}/`} class="inline-flex items-center gap-1 self-center font-semibold text-primary text-sm">{svc.data.shortTitle ?? svc.data.title} <Icon name="arrow" class="w-4 h-4" /></a>}
            </div>
          </li>
        ); })}
      </ul>
    </div>
  </section>
)}
