---
/**
 * Trust strip under the hero. Shows third-party badge images (trust.logos)
 * when present, otherwise the icon badges (trust.badges). Both hidden when blank.
 */
import { siteConfig } from '@config';
import Icon from '@/components/Icon.astro';
const { badges, logos } = siteConfig.trust;
---
{logos.length > 0 ? (
  <section class="border-y border-slate-200 bg-white">
    <ul class="container-x py-5 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      {logos.map((l) => (
        <li>{l.href ? <a href={l.href} target="_blank" rel="noopener nofollow"><img src={l.src} alt={l.alt} height="48" width="140" class="h-10 md:h-12 w-auto" loading="lazy" /></a> : <img src={l.src} alt={l.alt} height="48" width="140" class="h-10 md:h-12 w-auto" loading="lazy" />}</li>
      ))}
    </ul>
  </section>
) : badges.length > 0 ? (
  <section class="border-y border-slate-200 bg-white">
    <ul class="container-x py-5 grid grid-cols-2 md:grid-cols-4 gap-4 text-sm font-semibold text-secondary">
      {badges.map((b) => <li class="flex items-center gap-2 justify-center"><Icon name={b.icon ?? 'check'} class="w-5 h-5 text-primary shrink-0" />{b.label}</li>)}
    </ul>
  </section>
) : null}
