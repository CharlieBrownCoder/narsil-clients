---
import { getCollection } from 'astro:content';
import { siteConfig } from '@config';
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
interface Props { title?: string; intro?: string; limit?: number; only?: string[]; citySlug?: string; cityName?: string; moreHref?: string; }
const { title = 'Our Services', intro, limit, only, citySlug, cityName, moreHref } = Astro.props;
const emergencyOn = siteConfig.business.emergency?.available;
const photo = siteConfig.theme.serviceCards === 'photo';
let services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
if (only?.length) services = services.filter((s) => only.includes(s.id));
if (limit) services = services.slice(0, limit);
const href = (id: string) => (citySlug ? `/service-areas/${citySlug}/${id}/` : `/services/${id}/`);
---
<section class="section">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow">What we do</p>
      <h2 class="mt-2">{title}</h2>
      {intro && <p class="mt-4 text-lg text-slate-600">{intro}</p>}
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((s) => (
        <a href={href(s.id)} class:list={['card group hover:border-primary hover:shadow-md transition-all flex flex-col overflow-hidden', photo && s.data.image ? 'p-0' : 'p-6']}>
          {photo && s.data.image ? (
            <div class="relative"><Image src={s.data.image} alt={s.data.imageAlt ?? s.data.title} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, 100vw" class="w-full aspect-[16/10] object-cover" /><span class="absolute left-4 -bottom-5 w-11 h-11 rounded-[var(--radius-brand)] bg-primary text-white flex items-center justify-center shadow-md"><Icon name={s.data.icon} class="w-5 h-5" /></span></div>
          ) : (
            <span class="w-12 h-12 rounded-[var(--radius-brand)] bg-primary/10 text-primary flex items-center justify-center"><Icon name={s.data.icon} class="w-6 h-6" /></span>
          )}
          <div class:list={photo && s.data.image ? 'p-6 pt-8 flex flex-col flex-1' : 'contents'}>
          <h3 class:list={['group-hover:text-primary', photo && s.data.image ? 'mt-0' : 'mt-5']}>{s.data.shortTitle ?? s.data.title}{cityName && ` in ${cityName}`}</h3>
          {emergencyOn && s.data.emergency && <span class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-accent"><Icon name="clock" class="w-3.5 h-3.5" /> Available 24/7</span>}
          <p class="mt-2 text-slate-600 flex-1">{s.data.excerpt}</p>
          <span class="mt-4 inline-flex items-center gap-1 font-semibold text-primary">Learn more <Icon name="arrow" class="w-4 h-4 transition-transform group-hover:translate-x-1" /></span>
          </div>
        </a>
      ))}
    </div>
    {moreHref && <a href={moreHref} class="mt-6 inline-flex items-center gap-1 font-semibold text-primary">About {title.toLowerCase()} <Icon name="arrow" class="w-4 h-4" /></a>}
  </div>
</section>
