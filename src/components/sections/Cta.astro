---
import { siteConfig } from '@config';
import Icon from '@/components/Icon.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import { telHref } from '@/lib/utils';
interface Props { title?: string; text?: string; prevBg?: string }
const { business, pages } = siteConfig;
const promise = business.responseTimePromise?.trim();
const defaultText = promise
  ? `Call ${business.phone} or send us a message. ${promise.replace(/[.!]?$/, '.')}`
  : `Call ${business.phone} or send us a message and we will get back to you with a free quote.`;
const { title = 'Ready for a free quote?', text = defaultText, prevBg = '#ffffff' } = Astro.props;
---
<section class="relative bg-primary text-white">
  <SectionDivider position="top" fill={prevBg} />
  <div class="container-x py-14 pt-20 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
    <div class="max-w-2xl">
      <h2 class="!text-white">{title}</h2>
      <p class="mt-3 text-lg text-white/85">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3 shrink-0">
      <a href={telHref()} class="btn-accent"><Icon name="phone" class="w-5 h-5" /> {business.phone}</a>
      {pages.contact && <a href="/contact/" data-cta="band-quote" class="btn-ghost">Request a Quote</a>}
    </div>
  </div>
</section>
