---
import { siteConfig } from '@config';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/Icon.astro';
import Stars from '@/components/Stars.astro';
import { telHref } from '@/lib/utils';
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** override theme.heroStyle */
  style?: 'split' | 'centered' | 'image-bg';
  compact?: boolean;
}
const { eyebrow, title, subtitle, image, imageAlt = '', style = siteConfig.theme.heroStyle, compact = false } = Astro.props;
const { business, trust, pages } = siteConfig;
const hasImage = !!image;
const layout = hasImage ? style : 'centered';
---
{layout === 'image-bg' ? (
  <section class="relative isolate overflow-hidden bg-secondary text-white">
    <Image src={image!} alt={imageAlt} widths={[640, 1024, 1600]} sizes="100vw" class="absolute inset-0 w-full h-full object-cover opacity-40" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-secondary via-secondary/80 to-transparent"></div>
    <div class:list={['container-x relative', compact ? 'py-20' : 'py-28 md:py-40']}>
      <div class="max-w-2xl">
        {eyebrow && <p class="eyebrow !text-accent">{eyebrow}</p>}
        <h1 class="mt-3 !text-white">{title}</h1>
        <p class="mt-6 text-lg md:text-xl text-slate-200">{subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={telHref()} class="btn-accent"><Icon name="phone" class="w-5 h-5" /> {business.phone}</a>
          {pages.contact && <a href="/contact/" class="btn-ghost">Get a Free Quote</a>}
        </div>
        {trust.rating && <p class="mt-6 flex items-center gap-2 text-sm text-slate-200"><Stars rating={trust.rating.value} class="w-4 h-4" /> {trust.rating.value} rating from {trust.rating.count}+ {trust.rating.source} reviews</p>}
      </div>
    </div>
  </section>
) : layout === 'split' ? (
  <section class="bg-neutral">
    <div class:list={['container-x grid lg:grid-cols-2 gap-12 items-center', compact ? 'py-14' : 'py-20 md:py-28']}>
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="mt-3">{title}</h1>
        <p class="mt-6 text-lg md:text-xl text-slate-600">{subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={telHref()} class="btn-primary"><Icon name="phone" class="w-5 h-5" /> {business.phone}</a>
          {pages.contact && <a href="/contact/" class="btn-outline">Get a Free Quote</a>}
        </div>
        {trust.rating && <p class="mt-6 flex items-center gap-2 text-sm text-slate-600"><Stars rating={trust.rating.value} class="w-4 h-4" /> <strong>{trust.rating.value}</strong> from {trust.rating.count}+ {trust.rating.source} reviews</p>}
      </div>
      <div class="relative">
        <Image src={image!} alt={imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" class="w-full h-auto object-cover rounded-[var(--radius-brand)] shadow-2xl" loading="eager" fetchpriority="high" />
        {trust.guarantees[0] && <div class="absolute -bottom-5 left-6 card px-5 py-3 flex items-center gap-2 font-semibold text-secondary"><Icon name="shield" class="w-5 h-5 text-primary" />{trust.guarantees[0]}</div>}
      </div>
    </div>
  </section>
) : (
  <section class="bg-neutral">
    <div class:list={['container-x text-center max-w-4xl', compact ? 'py-14' : 'py-20 md:py-28']}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="mt-3">{title}</h1>
      <p class="mt-6 text-lg md:text-xl text-slate-600 max-w-2xl mx-auto">{subtitle}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={telHref()} class="btn-primary"><Icon name="phone" class="w-5 h-5" /> {business.phone}</a>
        {pages.contact && <a href="/contact/" class="btn-outline">Get a Free Quote</a>}
      </div>
    </div>
  </section>
)}
