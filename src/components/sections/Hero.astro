---
/**
 * Hero with four layouts (theme.heroStyle). The home page passes the config
 * hero block; inner pages pass compact title/subtitle and get the same style
 * at a smaller height, without the form.
 */
import { siteConfig } from '@config';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/Icon.astro';
import Headline from '@/components/Headline.astro';
import ResponsePromise from '@/components/ResponsePromise.astro';
import Stars from '@/components/Stars.astro';
import SectionDivider from '@/components/SectionDivider.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import { telHref } from '@/lib/utils';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  image?: ImageMetadata;
  imageAlt?: string;
  cutout?: ImageMetadata;
  bullets?: string[];
  /** override theme.heroStyle */
  style?: 'photo' | 'cutout' | 'split' | 'centered';
  /** show the quote form in the hero (home page only by default) */
  form?: boolean;
  compact?: boolean;
  /** color of the section that follows, for the divider */
  nextBg?: string;
}
const { theme, business, trust, pages } = siteConfig;
const { eyebrow, title, subtitle, image, imageAlt = '', cutout, bullets = [], style = theme.heroStyle, form = false, compact = false, nextBg = '#ffffff' } = Astro.props;
const layout: 'photo' | 'cutout' | 'split' | 'centered' = style === 'photo' && !image ? 'cutout' : style === 'split' && !image && !form ? 'centered' : style === 'cutout' && !cutout ? (image ? 'photo' : 'centered') : style;
const dark = layout === 'photo' || layout === 'cutout' || (layout === 'centered' && !!image);
const showForm = form && pages.contact;
const showBullets = !compact && bullets.length > 0;
const pad = compact ? 'py-14 md:py-20' : showForm ? 'py-16 md:py-24' : 'py-20 md:py-32';
const headingCls = `mt-3 ${dark ? '!text-white' : ''} ${compact ? '!text-3xl md:!text-5xl' : ''}`;
const ratingLine = trust.rating ? `${trust.rating.value} stars from ${trust.rating.count}+ ${trust.rating.source} reviews` : '';
---
<section class:list={['relative isolate overflow-hidden', dark ? (theme.heroScrim === 'brand' ? 'bg-primary-dark text-white' : 'bg-secondary text-white') : 'bg-neutral']} data-hero={layout}>
  {layout === 'photo' && image && (
    <>
      <Image src={image} alt={imageAlt} widths={[480, 800, 1024, 1600, 2000]} sizes="100vw" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" />
      {theme.heroScrim === 'duotone' && <div class="absolute inset-0 bg-primary mix-blend-color" aria-hidden="true"></div>}
      <div class:list={['absolute inset-0 bg-gradient-to-r', theme.heroScrim === 'brand' ? 'from-primary-dark via-primary-dark/85 to-primary-dark/30' : 'from-secondary via-secondary/85 to-secondary/30']} aria-hidden="true"></div>
      <div class:list={['absolute inset-0 bg-gradient-to-t via-transparent to-transparent', theme.heroScrim === 'brand' ? 'from-primary-dark/70' : 'from-secondary/70']} aria-hidden="true"></div>
    </>
  )}
  {layout === 'centered' && image && (
    <>
      <Image src={image} alt={imageAlt} widths={[480, 800, 1024, 1600, 2000]} sizes="100vw" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" />
      {theme.heroScrim === 'duotone' && <div class="absolute inset-0 bg-primary mix-blend-color" aria-hidden="true"></div>}
      <div class:list={['absolute inset-0', theme.heroScrim === 'brand' ? 'bg-primary-dark/75' : 'bg-secondary/75']} aria-hidden="true"></div>
    </>
  )}
  {layout === 'cutout' && (
    <div class="absolute inset-0 bg-gradient-to-br from-primary-dark via-secondary to-secondary" aria-hidden="true"></div>
  )}

  <div class:list={['container-x relative', pad]}>
    <div class:list={['grid gap-10 lg:gap-14 items-center', layout === 'centered' ? 'justify-items-center text-center' : 'lg:grid-cols-12']}>
      <div class:list={[layout === 'centered' ? 'max-w-3xl' : showForm || layout !== 'photo' ? 'lg:col-span-7' : 'lg:col-span-8 max-w-3xl']}>
        {eyebrow && <p class:list={['eyebrow', dark && '!text-accent']}>{eyebrow}</p>}
        <Headline text={title} as="h1" class={headingCls} />
        <p class:list={['mt-5 text-lg md:text-xl max-w-2xl', dark ? 'text-slate-200' : 'text-slate-600', layout === 'centered' && 'mx-auto']}>{subtitle}</p>
        {showBullets && siteConfig.hero.bulletStyle === 'pills' ? (
          <ul class:list={['mt-6 flex flex-wrap gap-2 text-sm font-semibold', layout === 'centered' && 'justify-center']}>
            {bullets.slice(0, 4).map((b) => <li class:list={['inline-flex items-center gap-2 px-3 py-1.5 rounded-full border', dark ? 'border-white/25 bg-white/10 text-white' : 'border-slate-200 bg-white text-secondary']}><Icon name="check" class="w-4 h-4 text-accent shrink-0" />{b}</li>)}
          </ul>
        ) : showBullets ? (
          <ul class:list={['mt-6 grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm font-semibold max-w-xl', dark ? 'text-white' : 'text-secondary', layout === 'centered' && 'mx-auto text-left']}>
            {bullets.slice(0, 4).map((b) => <li class="flex items-center gap-2"><Icon name="check" class="w-5 h-5 text-accent shrink-0" />{b}</li>)}
          </ul>
        ) : null}
        <div class:list={['mt-8 grid grid-cols-2 sm:flex sm:flex-wrap gap-3', layout === 'centered' && 'sm:justify-center']}>
          {pages.contact && <a href="/contact/" data-cta="hero-quote" class:list={[dark ? 'btn-accent' : 'btn-primary', '!px-4 sm:!px-6']}>Get a Free Quote</a>}
          <a href={telHref()} class:list={[dark ? 'btn-ghost' : 'btn-outline', '!px-4 sm:!px-6']}><Icon name="phone" class="w-5 h-5 shrink-0" /> <span class="sm:hidden">Call Now</span><span class="hidden sm:inline">{business.phone}</span></a>
        </div>
        {siteConfig.hero.ctaNote && !compact && <p class:list={['mt-2 text-xs', dark ? 'text-slate-300' : 'text-slate-500', layout === 'centered' && 'text-center']}>{siteConfig.hero.ctaNote}</p>}
        <ResponsePromise class={`mt-4 ${layout === 'centered' ? 'justify-center' : ''}`} light={dark} />
        {ratingLine && !compact && <p class:list={['mt-3 flex items-center gap-2 text-sm', dark ? 'text-slate-200' : 'text-slate-600', layout === 'centered' && 'justify-center']}><Stars rating={trust.rating!.value} class="w-4 h-4" /> {ratingLine}</p>}
      </div>

      {layout !== 'centered' && (
        <div class:list={['relative', showForm || layout !== 'photo' ? 'lg:col-span-5' : 'hidden']}>
          {showForm ? (
            <div class="lg:ml-auto lg:max-w-md text-secondary"><ContactForm compact /></div>
          ) : layout === 'cutout' && cutout ? (
            <div class="relative flex justify-center lg:justify-end">
              <div class="absolute inset-x-8 bottom-0 top-10 rounded-full bg-primary/30 blur-2xl" aria-hidden="true"></div>
              <Image src={cutout} alt={imageAlt} widths={[480, 800, 1000]} sizes="(min-width: 1024px) 40vw, 80vw" class="relative w-full max-w-md h-auto object-contain drop-shadow-2xl" loading="eager" fetchpriority="high" />
            </div>
          ) : layout === 'split' && image ? (
            <>
              <Image src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" class="w-full h-auto object-cover rounded-[var(--radius-brand)] shadow-2xl" loading="eager" fetchpriority="high" />
              {trust.guarantees[0] && <div class="absolute -bottom-5 left-6 card px-5 py-3 flex items-center gap-2 font-semibold text-secondary"><Icon name="shield" class="w-5 h-5 text-primary" />{trust.guarantees[0]}</div>}
            </>
          ) : null}
        </div>
      )}
    </div>
  </div>
  {!compact && <SectionDivider fill={nextBg} />}
</section>
