---
/** Licenses, insurance, certifications from config. Hidden when the list is empty. */
import { siteConfig } from '@config';
import Icon from '@/components/Icon.astro';
interface Props { title?: string; compact?: boolean }
const { title = 'Licensed, insured, and certified', compact = false } = Astro.props;
const items = siteConfig.business.credentials;
const icon: Record<string, string> = { license: 'shield', insurance: 'shield', certification: 'check', affiliation: 'users', award: 'star' };
const label: Record<string, string> = { license: 'License', insurance: 'Insurance', certification: 'Certification', affiliation: 'Member', award: 'Award' };
---
{items.length > 0 && (
  <section class:list={[compact ? 'py-10' : 'section', 'bg-neutral']}>
    <div class="container-x">
      {!compact && <><p class="eyebrow">Credentials</p><h2 class="mt-2">{title}</h2></>}
      <ul class:list={['grid sm:grid-cols-2 lg:grid-cols-3 gap-4', !compact && 'mt-8']}>
        {items.map((c) => (
          <li class="card p-5 flex gap-3">
            <Icon name={icon[c.type]} class="w-6 h-6 text-primary shrink-0" />
            <div>
              <p class="text-xs uppercase tracking-wide text-slate-500">{label[c.type]}</p>
              <p class="font-semibold text-secondary">{c.url ? <a href={c.url} target="_blank" rel="noopener" class="hover:text-primary">{c.label}</a> : c.label}</p>
              {(c.number || c.issuer) && <p class="text-sm text-slate-600">{[c.issuer, c.number ? `#${c.number}` : ''].filter(Boolean).join(' · ')}</p>}
              {c.expires && <p class="text-xs text-slate-500">Valid through {c.expires}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
