---
import { siteConfig } from '@config';
import { getCollection } from 'astro:content';
interface Props { service?: string; city?: string; compact?: boolean }
const { service, city, compact = false } = Astro.props;
const { forms } = siteConfig;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const action = forms.provider === 'netlify' ? forms.thankYouPath : forms.action ?? '#';
const netlify = forms.provider === 'netlify';
const inputCls = 'w-full border border-slate-300 rounded-[var(--radius-brand)] px-4 py-3 focus:border-primary focus:ring-2 focus:ring-primary/30 outline-none';
---
<form
  id="quote"
  name="quote"
  method="POST"
  action={action}
  data-netlify={netlify ? 'true' : undefined}
  netlify-honeypot={netlify ? 'company' : undefined}
  class="card p-6 md:p-8 grid gap-4"
>
  {netlify && <input type="hidden" name="form-name" value="quote" />}
  <p class="hidden"><label>Company <input name="company" /></label></p>
  {!compact && <h2 class="text-2xl">Request a free quote</h2>}
  <div class="grid sm:grid-cols-2 gap-4">
    <label class="grid gap-1 text-sm font-medium">Name<input class={inputCls} name="name" type="text" required autocomplete="name" /></label>
    <label class="grid gap-1 text-sm font-medium">Phone<input class={inputCls} name="phone" type="tel" required autocomplete="tel" /></label>
  </div>
  <label class="grid gap-1 text-sm font-medium">Email<input class={inputCls} name="email" type="email" autocomplete="email" /></label>
  <div class="grid sm:grid-cols-2 gap-4">
    <label class="grid gap-1 text-sm font-medium">Service
      <select class={inputCls} name="service">
        <option value="">Select a service</option>
        {services.map((s) => <option value={s.data.title} selected={s.id === service}>{s.data.title}</option>)}
        <option value="Other">Other</option>
      </select>
    </label>
    <label class="grid gap-1 text-sm font-medium">City / ZIP<input class={inputCls} name="city" type="text" value={city ?? ''} autocomplete="address-level2" /></label>
  </div>
  <label class="grid gap-1 text-sm font-medium">Tell us about the job<textarea class={inputCls} name="message" rows={compact ? 3 : 4}></textarea></label>
  <input type="hidden" name="source_page" value={Astro.url.pathname} />
  <button type="submit" class="btn-primary w-full">Get My Free Quote</button>
  <p class="text-xs text-slate-500 text-center">No spam, ever. We’ll reply within one business day.</p>
</form>
