---
/** Maintenance plan tiers from config.plans. Hidden when empty. */
import { siteConfig } from '@config';
import Icon from '@/components/Icon.astro';
const { plans, pages, pricing } = siteConfig;
interface Props { title?: string; intro?: string }
const { title = 'Maintenance plans', intro = 'Lock in a schedule and a price. Cancel any time.' } = Astro.props;
---
{plans.length > 0 && (
  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl"><p class="eyebrow">Plans</p><h2 class="mt-2">{title}</h2><p class="mt-4 text-lg text-slate-600">{intro}</p></div>
      <ul class:list={['mt-10 grid gap-6', plans.length === 2 ? 'md:grid-cols-2 max-w-4xl' : 'md:grid-cols-3']}>
        {plans.map((p) => (
          <li class:list={['card p-7 flex flex-col relative', p.highlight && 'border-primary ring-2 ring-primary/30']}>
            {p.highlight && <span class="absolute -top-3 left-6 text-xs font-bold uppercase tracking-wide bg-accent text-secondary px-3 py-1 rounded-full">Most popular</span>}
            <h3 class="text-xl">{p.name}</h3>
            <p class="mt-3"><span class="font-heading text-4xl font-extrabold text-secondary">{p.price}</span> <span class="text-slate-500">{p.period}</span></p>
            <p class="mt-2 text-slate-600">{p.description}</p>
            <ul class="mt-5 space-y-2 flex-1">{p.features.map((f) => <li class="flex gap-2 text-sm"><Icon name="check" class="w-5 h-5 text-primary shrink-0" />{f}</li>)}</ul>
            {pages.contact && <a href="/contact/" data-cta={`plan-${p.name.toLowerCase().replace(/\s+/g, '-')}`} class:list={['mt-6', p.highlight ? 'btn-primary' : 'btn-outline']}>Start this plan</a>}
          </li>
        ))}
      </ul>
      <p class="mt-4 text-sm text-slate-500">{pricing.disclaimer}</p>
    </div>
  </section>
)}
