---
import type { Crumb } from '@/lib/schema';
interface Props { crumbs: Crumb[]; class?: string }
const { crumbs, class: cls = '' } = Astro.props;
---
<nav aria-label="Breadcrumb" class:list={['text-sm text-slate-500', cls]}>
  <ol class="flex flex-wrap items-center gap-1.5">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === crumbs.length - 1 ? <span class="text-slate-700 font-medium" aria-current="page">{c.name}</span> : <a href={c.path} class="hover:text-primary">{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
