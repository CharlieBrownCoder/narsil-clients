---
/**
 * Trustindex review widget. One placement = one widget ID from the Trustindex
 * dashboard. Renders nothing when the ID is blank, so pages stay clean for
 * clients who haven't set it up yet. The loader script is injected after the
 * page has loaded and the widget is near the viewport, so it never competes
 * with the hero image for bandwidth (it was the main cause of a 3 s mobile LCP).
 * The loader script goes INSIDE the widget container, because Trustindex renders
 * the widget beside its own script tag: appended to <body> it rendered below the
 * footer and the container stayed 0px tall.
 */
import { siteConfig } from '@config';
interface Props {
  placement: 'home' | 'page' | 'compact' | 'badge';
  title?: string;
  /** wrap in a section with container; false for inline (footer badge) */
  section?: boolean;
  dark?: boolean;
}
const { placement, title, section = true, dark = false } = Astro.props;
const id = siteConfig.reviews.trustindex[placement];
const { trust, business } = siteConfig;
---
{id && (
  section ? (
    <section class:list={['section', dark ? 'bg-secondary text-white' : 'bg-white']}>
      <div class="container-x">
        {title && (
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
            <div>
              <p class:list={['eyebrow', dark && '!text-accent']}>Reviews</p>
              <h2 class:list={['mt-2', dark && '!text-white']}>{title}</h2>
            </div>
            {trust.rating && <p class:list={['text-sm', dark ? 'text-slate-300' : 'text-slate-600']}><strong>{trust.rating.value}</strong> from {trust.rating.count} {trust.rating.source} reviews</p>}
          </div>
        )}
        <div class="ti-widget" data-ti-widget={id} data-ti-loader={`https://cdn.trustindex.io/loader.js?${id}`}></div>
        {business.googleReviewUrl && <a href={business.googleReviewUrl} target="_blank" rel="noopener" class:list={['mt-8', dark ? 'btn-accent' : 'btn-outline']}>Leave a review</a>}
      </div>
    </section>
  ) : (
    <div>
      <div class="ti-widget" data-ti-widget={id} data-ti-loader={`https://cdn.trustindex.io/loader.js?${id}`}></div>
    </div>
  )
)}
{id && (
  <script is:inline>
    (function () {
      if (window.__tiDeferred) return; window.__tiDeferred = true;
      var loaded = {};
      function inject(el) { var src = el.getAttribute('data-ti-loader'); if (!src || loaded[src]) return; loaded[src] = true; var s = document.createElement('script'); s.async = true; s.defer = true; s.src = src; el.appendChild(s); }
      function arm() {
        var els = document.querySelectorAll('[data-ti-loader]');
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) { entries.forEach(function (e) { if (e.isIntersecting) { inject(e.target); io.unobserve(e.target); } }); }, { rootMargin: '600px 0px' });
          els.forEach(function (el) { io.observe(el); });
        } else { els.forEach(inject); }
      }
      if (document.readyState === 'complete') arm(); else window.addEventListener('load', function () { (window.requestIdleCallback || function (cb) { setTimeout(cb, 200); })(arm); });
    })();
  </script>
)}
