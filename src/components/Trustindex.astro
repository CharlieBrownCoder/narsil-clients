---
/**
 * Trustindex review widget. One placement = one widget ID from the Trustindex
 * dashboard. Renders nothing when the ID is blank, so pages stay clean for
 * clients who haven't set it up yet. The loader script is deferred and only
 * added when a widget renders.
 */
import { siteConfig } from '@config';
interface Props {
  placement: 'home' | 'page' | 'compact' | 'badge';
  title?: string;
  /** wrap in a section with container; false for inline (footer badge) */
  section?: boolean;
  dark?: boolean;
}
const { placement, title, section = true, dark = false } = Astro.props;
const id = siteConfig.reviews.trustindex[placement];
const { trust, business } = siteConfig;
---
{id && (
  section ? (
    <section class:list={['section', dark ? 'bg-secondary text-white' : 'bg-white']}>
      <div class="container-x">
        {title && (
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
            <div>
              <p class:list={['eyebrow', dark && '!text-accent']}>Reviews</p>
              <h2 class:list={['mt-2', dark && '!text-white']}>{title}</h2>
            </div>
            {trust.rating && <p class:list={['text-sm', dark ? 'text-slate-300' : 'text-slate-600']}><strong>{trust.rating.value}</strong> from {trust.rating.count} {trust.rating.source} reviews</p>}
          </div>
        )}
        <div class="ti-widget" data-ti-widget={id}></div>
        <script is:inline defer async src={`https://cdn.trustindex.io/loader.js?${id}`}></script>
        {business.googleReviewUrl && <a href={business.googleReviewUrl} target="_blank" rel="noopener" class:list={['mt-8', dark ? 'btn-accent' : 'btn-outline']}>Leave a review</a>}
      </div>
    </section>
  ) : (
    <div>
      <div class="ti-widget" data-ti-widget={id}></div>
      <script is:inline defer async src={`https://cdn.trustindex.io/loader.js?${id}`}></script>
    </div>
  )
)}
