---
import '@/styles/global.css';
import { siteConfig } from '@config';
import Seo from '@/components/Seo.astro';
import Tracking from '@/components/Tracking.astro';
import JsonLd from '@/components/JsonLd.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileCallBar from '@/components/MobileCallBar.astro';
import StickyQuoteTab from '@/components/StickyQuoteTab.astro';
import type { PageMeta } from '@/lib/seo';
import { lastmodForPath } from '@/lib/site-pages';

interface Props {
  meta: PageMeta;
  /** Composed JSON-LD graph for this page. */
  schema?: Record<string, unknown>;
}
const { meta, schema } = Astro.props;
// The page's WebPage node says the same date the sitemap does: the last commit touching
// the page's sources. Views that set their own dateModified keep it.
const lastmod = await lastmodForPath(meta.canonical);
if (schema && lastmod) {
  const nodes = Array.isArray((schema as { '@graph'?: unknown[] })['@graph']) ? ((schema as { '@graph': Record<string, unknown>[] })['@graph']) : [schema as Record<string, unknown>];
  const page = nodes.find((n) => typeof n['@id'] === 'string' && (n['@id'] as string).endsWith('#webpage'));
  if (page && !page.dateModified) page.dateModified = lastmod;
}
const t = siteConfig.theme;
const radius = { sharp: '0px', rounded: '0.75rem', pill: '9999px' }[t.radius];
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const families = [...new Set([t.fontHeading, t.fontBody])];
const fontFaces = families
  .map((f) => `@font-face{font-family:"${f}";font-style:normal;font-weight:100 900;font-display:swap;src:url(/fonts/${slug(f)}.woff2) format("woff2")}`)
  .join('');
const rootVars = `:root{--brand-primary:${t.primary};--brand-primary-dark:${t.primaryDark};--brand-secondary:${t.secondary};--brand-accent:${t.accent};--brand-neutral:${t.neutral};--brand-font-heading:"${t.fontHeading}";--brand-font-body:"${t.fontBody}";--brand-radius:${radius};}`;
---
<!doctype html>
<html lang="en" data-heading-case={t.headingCase} data-buttons={t.buttonStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={t.primary} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {families.map((f) => <link rel="preload" href={`/fonts/${slug(f)}.woff2`} as="font" type="font/woff2" crossorigin />)}
    <style set:html={fontFaces + rootVars} />
    <Seo meta={meta} />
    {schema && <JsonLd data={schema} />}
    <Tracking />
  </head>
  <body class="min-h-screen flex flex-col">
    {siteConfig.tracking.gtm && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${siteConfig.tracking.gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 btn-primary">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
    <StickyQuoteTab />
  </body>
</html>
