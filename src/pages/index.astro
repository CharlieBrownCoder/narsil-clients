---
import { getCollection } from 'astro:content';
import { siteConfig } from '@config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import TrustBar from '@/components/sections/TrustBar.astro';
import EmergencyCta from '@/components/sections/EmergencyCta.astro';
import TeamGrid from '@/components/sections/TeamGrid.astro';
import ServiceGrid from '@/components/sections/ServiceGrid.astro';
import WhyUs from '@/components/sections/WhyUs.astro';
import Trustindex from '@/components/Trustindex.astro';
import Gallery from '@/components/sections/Gallery.astro';
import LocationGrid from '@/components/sections/LocationGrid.astro';
import Faq from '@/components/sections/Faq.astro';
import Cta from '@/components/sections/Cta.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import { homeMeta } from '@/lib/seo';
import { requireAsset, asset } from '@/lib/images';
import StatsStrip from '@/components/sections/StatsStrip.astro';
import { getBusinessType } from '@/lib/business-types';
import * as S from '@/lib/schema';

const { business, pages, hero, trust, theme } = siteConfig;
const bt = getBusinessType(siteConfig.businessType);
const meta = homeMeta();
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const locations = (await getCollection('locations')).sort((a, b) => a.data.order - b.data.order);
const faqs = (await getCollection('faqs')).filter((f) => f.data.category === 'general').sort((a, b) => a.data.order - b.data.order).map((f) => f.data).slice(0, 6);

const schema = S.graph(
  S.localBusiness({
    full: true,
    areas: locations.map((l) => ({ city: l.data.city, state: l.data.state, cityUrl: l.data.cityUrl })),
    services: services.map((s) => ({ name: s.data.title, url: `/services/${s.id}/` })),
  }),
  S.webSite(),
  S.webPage({ path: '/', title: meta.title, description: meta.description }),
  S.breadcrumbList('/', [{ name: 'Home', path: '/' }]),
  S.faqPage('/', faqs),
);
---
<BaseLayout meta={meta} schema={schema}>
  <Hero
    eyebrow={hero.eyebrow || `${bt.label} in ${business.address.city}, ${business.address.state}`}
    title={hero.headline}
    subtitle={hero.subheadline}
    image={requireAsset(hero.image)}
    imageAlt={hero.imageAlt}
    cutout={asset(hero.cutout)}
    bullets={hero.bullets.length ? hero.bullets : trust.badges.map((b) => b.label)}
    form={theme.heroForm}
  />
  <TrustBar />
  <StatsStrip />
  <EmergencyCta compact />
  {pages.services && <ServiceGrid intro={`Professional ${bt.label.toLowerCase()} services for homes and businesses in ${business.address.city} and surrounding communities.`} />}
  <WhyUs />
  <TeamGrid limit={3} />
  {pages.gallery && <Gallery limit={3} />}
  <Trustindex placement="home" title="What our customers say" dark />
  {pages.serviceAreas && <LocationGrid limit={8} />}
  <Faq faqs={faqs} />
  <section class="section bg-neutral" id="get-a-quote">
    <div class="container-x grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <p class="eyebrow">Get started</p>
        <h2 class="mt-2">Get your free {bt.label.toLowerCase()} quote</h2>
        <p class="mt-4 text-lg text-slate-600">Tell us a little about the job and we’ll get back to you with a clear, no-obligation price. Prefer to talk? Call <a href={`tel:${business.phoneE164}`} class="font-semibold text-primary">{business.phone}</a>.</p>
      </div>
      <ContactForm compact />
    </div>
  </section>
  <Cta />
</BaseLayout>
