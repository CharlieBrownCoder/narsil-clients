---
import { siteConfig } from '@config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { telHref } from '@/lib/utils';
const meta = { title: `Page not found | ${siteConfig.business.name}`, description: 'That page doesn’t exist.', canonical: '/404/', noindex: true };
---
<BaseLayout meta={meta}>
  <section class="container-x py-28 text-center max-w-xl">
    <p class="eyebrow">404</p>
    <h1 class="mt-3">We couldn’t find that page</h1>
    <p class="mt-4 text-lg text-slate-600">It may have moved. Head back home or give us a call and we’ll point you in the right direction.</p>
    <div class="mt-8 flex justify-center gap-3"><a href="/" class="btn-primary">Back home</a><a href={telHref()} class="btn-outline"><Icon name="phone" class="w-5 h-5" /> {siteConfig.business.phone}</a></div>
  </section>
</BaseLayout>
